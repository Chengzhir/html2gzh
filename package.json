{
  "name": "html2gzh",
  "version": "0.1.0",
  "private": true,
  "description": "把 HTML 页面转成公众号编辑器能保留的格式，粘贴为公众号图文；本地图片临时提供给微信取走",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server.ts",
    "format": "prettier --write .",
    "check": "prettier --check . && tsc -p . && vue-tsc -p ui --noEmit",
    "pretest": "npm run build",
    "test": "node test/e2e.mjs && node test/e2e.mjs --svg && node test/e2e.mjs test/fixture-svg && node test/e2e.mjs test/fixture-webfont --svg"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "fontverter": "2.0.0",
    "mp-darkmode": "1.2.3-beta.8",
    "naive-ui": "2.45.3",
    "puppeteer-core": "25.13.0",
    "sharp": "0.35.5",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "11.2.7",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
