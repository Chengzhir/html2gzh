{
  "name": "html2gzh",
  "version": "0.1.0",
  "private": true,
  "description": "把 HTML 页面转成公众号编辑器能保留的格式，粘贴为公众号图文；本地图片临时提供给微信取走",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server.ts",
    "check": "tsc -p .",
    "pretest": "npm run build",
    "test": "node test/e2e.mjs && node test/e2e.mjs --svg && node test/e2e.mjs test/fixture-svg && node test/e2e.mjs test/fixture-webfont --svg"
  },
  "dependencies": {
    "fontkit": "2.0.4",
    "fontverter": "2.0.0",
    "puppeteer-core": "25.13.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
